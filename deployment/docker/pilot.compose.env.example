PV_EDGE_MANAGER_COMPOSE_PROJECT=pv-guardian-edge-pilot
PV_EDGE_MANAGER_BACKEND_CONTAINER=pv-guardian-backend-pilot
PV_EDGE_MANAGER_WEB_CONTAINER=pv-guardian-web-pilot
PV_EDGE_MANAGER_BACKEND_IMAGE=pv-guardian-edge-backend:pilot
PV_EDGE_MANAGER_WEB_IMAGE=pv-guardian-edge-web:pilot

PV_EDGE_MANAGER_ENV_FILE=/etc/pv-edge-manager-pilot/app.env
PV_EDGE_MANAGER_DATA_DIR=/var/lib/pv-edge-manager-pilot
PV_EDGE_MANAGER_LOG_DIR=/var/log/pv-edge-manager-pilot

PV_EDGE_MANAGER_WEB_BIND=18080
PV_EDGE_MANAGER_API_BIND=18000
PV_EDGE_MANAGER_MODBUS_TCP_SLAVE_BIND=15021
PV_EDGE_MANAGER_MODBUS_TCP_SLAVE_PORT=15020

PV_EDGE_MANAGER_VERSION=v1.0.0
PV_EDGE_MANAGER_RELEASE_TAG=local
PV_EDGE_MANAGER_BUILD_LABEL=v1.0.0-docker-pilot
PV_EDGE_MANAGER_BUILD_COMMIT=
PV_EDGE_MANAGER_BUILD_TIME=
