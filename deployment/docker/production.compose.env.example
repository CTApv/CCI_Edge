PV_EDGE_MANAGER_COMPOSE_PROJECT=pv-guardian-edge
PV_EDGE_MANAGER_BACKEND_CONTAINER=pv-guardian-backend
PV_EDGE_MANAGER_WEB_CONTAINER=pv-guardian-web
PV_EDGE_MANAGER_BACKEND_IMAGE=ghcr.io/ctapv/pv-guardian-edge-backend:v1.0.0
PV_EDGE_MANAGER_WEB_IMAGE=ghcr.io/ctapv/pv-guardian-edge-web:v1.0.0

PV_EDGE_MANAGER_ENV_FILE=/etc/pv-edge-manager/app.env
PV_EDGE_MANAGER_DATA_DIR=/var/lib/pv-edge-manager
PV_EDGE_MANAGER_LOG_DIR=/var/log/pv-edge-manager

PV_EDGE_MANAGER_WEB_BIND=80
PV_EDGE_MANAGER_API_BIND=8000
PV_EDGE_MANAGER_MODBUS_TCP_SLAVE_BIND=15020
PV_EDGE_MANAGER_MODBUS_TCP_SLAVE_PORT=15020

PV_EDGE_MANAGER_VERSION=v1.0.0
PV_EDGE_MANAGER_BUILD_LABEL=v1.0.0-docker
PV_EDGE_MANAGER_BUILD_COMMIT=
PV_EDGE_MANAGER_BUILD_TIME=
