PV_EDGE_MANAGER_VERSION=v1.0.0
PV_EDGE_MANAGER_BUILD_LABEL=v1.0.0-systemd
PV_EDGE_MANAGER_BUILD_COMMIT=
PV_EDGE_MANAGER_BUILD_TIME=
PV_EDGE_MANAGER_EDGE_ID=

PV_EDGE_MANAGER_DATABASE_PATH=/var/lib/pv-edge-manager/pv_edge_manager.db
PV_EDGE_MANAGER_HISTORY_DATABASE_PATH=/var/lib/pv-edge-manager/pv_edge_manager_history.db

PV_EDGE_MANAGER_MODBUS_TCP_SLAVE_ENABLED=true
PV_EDGE_MANAGER_MODBUS_TCP_SLAVE_HOST=0.0.0.0
PV_EDGE_MANAGER_MODBUS_TCP_SLAVE_PORT=15020
PV_EDGE_MANAGER_MODBUS_TCP_SLAVE_UNIT_ID=1

PV_EDGE_MANAGER_FLEET_DISPATCH_INTERVAL_SECONDS=5
PV_EDGE_MANAGER_POWER_HISTORY_LIMIT=2880
PV_EDGE_MANAGER_POWER_HISTORY_MAX_BYTES=2147483648
PV_EDGE_MANAGER_POWER_HISTORY_QUERY_MAX_POINTS=720
